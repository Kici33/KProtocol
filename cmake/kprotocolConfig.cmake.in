@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(ZLIB)
set(kprotocol_auth_FOUND @KPROTOCOL_BUILD_AUTH@)
set(kprotocol_client_FOUND @KPROTOCOL_BUILD_CLIENT@)
if(kprotocol_auth_FOUND)
    find_dependency(CURL)
    find_dependency(OpenSSL)
    find_dependency(Threads)
    find_dependency(nlohmann_json 3.11)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/kprotocolTargets.cmake")

set(kprotocol_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/kprotocol")
set(kprotocol_HAS_TRANSLATION_MAPPINGS FALSE)
set(kprotocol_TRANSLATION_MAPPINGS "")
if(EXISTS "${kprotocol_DATA_DIR}/translation_mappings.bin.gz")
    set(kprotocol_HAS_TRANSLATION_MAPPINGS TRUE)
    set(kprotocol_TRANSLATION_MAPPINGS
        "${kprotocol_DATA_DIR}/translation_mappings.bin.gz")
endif()

check_required_components(kprotocol)
