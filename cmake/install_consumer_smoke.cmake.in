set(prefix "@KPROTOCOL_INSTALL_SMOKE_PREFIX@")
set(consumer_build "@KPROTOCOL_INSTALL_SMOKE_BUILD@")

file(REMOVE_RECURSE "${prefix}" "${consumer_build}")

if(NOT INSTALL_CONFIG)
    set(INSTALL_CONFIG Release)
endif()

set(consumer_config_args
    "-DCMAKE_PREFIX_PATH=${prefix}"
    "-DCMAKE_BUILD_TYPE=Release")

set(parent_toolchain_file "@CMAKE_TOOLCHAIN_FILE@")
if(parent_toolchain_file)
    list(APPEND consumer_config_args
        "-DCMAKE_TOOLCHAIN_FILE=${parent_toolchain_file}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@KPROTOCOL_BINARY_DIR@"
            --prefix "${prefix}"
            --config "${INSTALL_CONFIG}"
    RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "kprotocol install failed: ${install_result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@"
            -S "@KPROTOCOL_SOURCE_DIR@/examples/consumer"
            -B "${consumer_build}"
            ${consumer_config_args}
    RESULT_VARIABLE configure_result)
if(NOT configure_result EQUAL 0)
    message(FATAL_ERROR "installed consumer configure failed: ${configure_result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${consumer_build}" --config "${INSTALL_CONFIG}"
    RESULT_VARIABLE build_result)
if(NOT build_result EQUAL 0)
    message(FATAL_ERROR "installed consumer build failed: ${build_result}")
endif()

set(consumer_candidates
    "${consumer_build}/consumer"
    "${consumer_build}/consumer.exe"
    "${consumer_build}/${INSTALL_CONFIG}/consumer"
    "${consumer_build}/${INSTALL_CONFIG}/consumer.exe")
set(consumer_exe "")
foreach(candidate IN LISTS consumer_candidates)
    if(EXISTS "${candidate}")
        set(consumer_exe "${candidate}")
        break()
    endif()
endforeach()
if(consumer_exe STREQUAL "")
    message(FATAL_ERROR "installed consumer executable was not found")
endif()

execute_process(
    COMMAND "${consumer_exe}"
    RESULT_VARIABLE run_result)
if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "installed consumer run failed: ${run_result}")
endif()
